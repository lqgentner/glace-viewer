{
  "type": "Collection",
  "stac_version": "1.1.0",
  "id": "fixture-mosaics",
  "title": "Fixture — two years, one combination built for only one of them",
  "description": "Not a published catalog: the shape of one, small enough to read.",
  "license": "CC-BY-4.0",
  "extent": {
    "spatial": {
      "bbox": [
        [
          5.0,
          44.0,
          12.0,
          48.0
        ]
      ]
    },
    "temporal": {
      "interval": [
        [
          "2022-06-01T00:00:00Z",
          "2023-09-30T00:00:00Z"
        ]
      ]
    }
  },
  "assets": {
    "style-default": {
      "href": "./style.json",
      "type": "application/vnd.mapbox.style+json",
      "title": "Fixture style",
      "description": "The most recent year only, as the store publishes it.",
      "roles": [
        "style",
        "default"
      ]
    }
  },
  "links": [
    {
      "rel": "root",
      "href": "../catalog.json",
      "type": "application/json"
    },
    {
      "rel": "license",
      "href": "https://creativecommons.org/licenses/by/4.0/",
      "type": "text/html"
    },
    {
      "rel": "item",
      "href": "./2022/item.json",
      "type": "application/geo+json"
    },
    {
      "rel": "item",
      "href": "./2023/item.json",
      "type": "application/geo+json"
    }
  ],
  "renders": {
    "coh12_vv": {
      "title": "Coherence VV",
      "assets": [
        "coh12_vv"
      ],
      "rescale": [
        [
          0.1,
          0.75
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "coh12_vh": {
      "title": "Coherence VH",
      "assets": [
        "coh12_vh"
      ],
      "rescale": [
        [
          0.1,
          0.55
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vv": {
      "title": "Backscatter VV",
      "assets": [
        "rtc_vv"
      ],
      "expression": "10*log10(rtc_vv_b1)",
      "rescale": [
        [
          -14.5,
          -4.5
        ]
      ],
      "colormap_name": "gray",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vh": {
      "title": "Backscatter VH",
      "assets": [
        "rtc_vh"
      ],
      "expression": "10*log10(rtc_vh_b1)",
      "rescale": [
        [
          -21.0,
          -11.0
        ]
      ],
      "colormap_name": "gray",
      "resampling": "average",
      "nodata": "nan"
    }
  }
}
