# Build outputs: generated from data/*.geojson by scripts/build-tiles.mjs, and by
# the deploy workflow. Committing them would cost ~7 MB of history per update,
# against ~144 kB for the GeoJSON they come from.
data/*.pmtiles

# The GLACE raster archives, mounted by scripts/serve.mjs at ./tiles. No trailing
# slash: this is usually a symlink to a local build, and git sees a symlink as a
# file, so `tiles/` would not match it.
tiles
_site/

# The page's libraries, which the deploy copies, and the test dependencies.
node_modules/

__pycache__/
.DS_Store
.dmypy*.json

.superpowers/
